# Firebase Configuration (Client-side)
# Copy this file to .env.local and fill in your Firebase values

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Realtime Database (required for Duel mode)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.europe-west1.firebasedatabase.app

# Firebase Admin SDK (Server-side - for API routes)
# Download service account key from Firebase Console > Project Settings > Service Accounts
# Note: PROJECT_ID is already defined above as NEXT_PUBLIC_FIREBASE_PROJECT_ID
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Resend (Email service)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# App URL (for email links)
NEXT_PUBLIC_APP_URL=https://parle-avec-tes-mains.fr

# Socket.io Server (for real-time features)
# URL of your Socket.io server (Raspberry Pi or other host)
NEXT_PUBLIC_SOCKET_URL=http://100.101.56.34:3001
